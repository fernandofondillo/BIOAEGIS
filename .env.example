# BioFish AI — Environment Variables Template
# Copy this file to .env and fill in your API keys
# Usage: cp .env.example .env

# =============================================================================
# LLM PROVIDERS — Configure one or more. BioFish AI auto-detects the best one.
# =============================================================================

# === PRIORITY 1: Groq (FREE — 500K tokens/day, ultra-fast) ===
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# === PRIORITY 2: MiniMax Code Plan ===
# Your Code Plan token (sk-cp-...)
MINIMAX_API_KEY=your_minimax_code_plan_key_here

# === PRIORITY 3: OpenRouter (140+ models) ===
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === OPTIONAL: Kimi / Moonshot AI (China-based) ===
KIMI_API_KEY=your_kimi_moonshot_api_key_here

# === OPTIONAL: OpenAI (GPT-4, GPT-4o) ===
OPENAI_API_KEY=your_openai_api_key_here

# === OPTIONAL: DeepSeek (cheap and fast) ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# === OPTIONAL: Anthropic (Claude) ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === OPTIONAL: Ollama local (free, unlimited, no API key needed) ===
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_ENABLED=false

# =============================================================================
# APPLICATION CONFIG
# =============================================================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=biofish_ai.log

# Simulation defaults
DEFAULT_SIMULATION_MONTHS=3
MAX_SIMULATION_MONTHS=60
AGENT_TIMEOUT_SECONDS=30

# LLM defaults
DEFAULT_LLM_PROVIDER=groq
LLM_FALLBACK_ORDER=groq,deepseek,openrouter,minimax,kimi,openai
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# Database (future: Supabase)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_KEY=your_service_key

# Optional: Supabase for persistence
# SUPABASE_ENABLED=false